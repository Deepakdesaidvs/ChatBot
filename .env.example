# Copy this file to ".env" and edit the copy. Lines starting with # are comments.

# ---- Model provider ----
# Use "ollama" for local inference or "openai" for hosted chat and embeddings.
LLM_PROVIDER=ollama

# ---- Ollama (keep it on localhost! never expose port 11434) ----
OLLAMA_HOST=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
VISION_MODEL=moondream
# Image understanding with a vision model is slow on CPU. Off by default (OCR still works).
ENABLE_VISION=false
OCR_ENABLED=true

# ---- Answer behaviour ----
# Low temperature = more factual, less creative (reduces hallucination)
TEMPERATURE=0.1
NUM_CTX=4096
MAX_ANSWER_TOKENS=600

# ---- Chunking and retrieval ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=6
# Minimum similarity (0-1) for a chunk to count as relevant. Raise to be stricter.
MIN_RELEVANCE=0.5

# ---- Upload limits ----
MAX_FILE_MB=25
MAX_TOTAL_MB=100
MAX_FILES=10
MAX_PAGES=200

# ---- Sessions and sharing ----
SESSION_TIMEOUT_MINUTES=60
# Leave blank for no login (fine on your own PC). SET A PASSWORD before sharing publicly.
APP_PASSWORD=
MAX_CONCURRENT_LLM=1
RATE_LIMIT_PER_MINUTE=6

# ---- Misc ----
DATA_DIR=data
LOG_LEVEL=INFO
ALLOW_REMOTE_OLLAMA=false

# ---- OpenAI (used only when LLM_PROVIDER=openai) ----
# Keep this key in your hosting provider's secret settings; never commit it.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small